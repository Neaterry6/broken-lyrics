{
  "name": "broken-lyrics",
  "version": "1.0.0",
  "description": "Song lyrics lookup with zero dependencies. Search, plain lyrics, synced LRC lyrics and timestamp parsing. No API key.",
  "keywords": [
    "lyrics", "lyrics-api", "lrc", "synced-lyrics", "song", "music",
    "lrclib", "karaoke", "zero-dependency", "fetch"
  ],
