  "author": "Akewushola Abdulbakri Temitope (brokenvzn) <akewusholaabdulbakri101@gmail.com>",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.mjs"
    }
  },
  "files": ["index.js", "index.mjs", "index.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test.js",
    "test:live": "node --test test-live.js"
  },
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "git+https://github.com/Neaterry6/broken-lyrics.git" },
  "bugs": { "url": "https://github.com/Neaterry6/broken-lyrics/issues" },
